# ============================================================
# TradeSwarm — .env.local.example
# Copy to .env.local and fill in values before running.
# Project: https://rnvaagbvribokkhuutznc.supabase.co
# ============================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://rnvaagbvribokkhuutznc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- AI (required) ---
GROQ_API_KEY=your-groq-api-key-here

# --- AI (optional) ---
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# --- Internal jobs (optional) ---
INTERNAL_JOBS_TOKEN=

# --- Auth redirect URL (set to localhost in dev, prod URL in production) ---
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000

# --- Replay / calibration thresholds (optional) ---
REPLAY_COVERAGE_THRESHOLD=0
REPLAY_MISMATCH_THRESHOLD=1
